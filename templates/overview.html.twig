{% extends 'partials/base.html.twig' %}

{% block content %}
    {% import 'macros/posts.html.twig' as posts %}
    {% import 'macros/icons.html.twig' as ic %}
    {% set h = page.header %}
    {% set items = page.children.published.order('date', 'desc') %}
    {# Übersicht: Kopf linksbündig über die volle Breite des Rasters #}
    <div class="page-head page-head-wide">
        <div class="crumbs"><a href="{{ base_url_relative ~ '/' }}">{{ 'THEME_ABOUTME.TO_HOME'|t }}</a> / {{ page.menu }}</div>
        {% if h.eyebrow %}<div class="eyebrow">{{ h.eyebrow }}</div>{% endif %}
        <h1>{{ page.title }}</h1>
        {% if h.lead %}<p class="lead">{{ h.lead }}</p>{% endif %}
    </div>
    {% if items|length %}
        <div class="post-grid">
            {% for post in items %}{{ posts.news(post) }}{% endfor %}
        </div>
    {% else %}
        <p class="prose">{{ 'THEME_ABOUTME.NO_POSTS'|t }}</p>
    {% endif %}
    <p class="post-back post-back-wide"><a class="pill-link" href="{{ base_url_relative ~ '/' }}">{{ 'THEME_ABOUTME.TO_HOME'|t }}{{ ic.icon('arrow') }}</a></p>
{% endblock %}
