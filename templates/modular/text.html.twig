{% set h = page.header %}
<section class="section" id="{{ h.anchor ?: page.slug }}">
    <div class="section-head">
        {% if h.eyebrow %}<span class="eyebrow">{{ h.eyebrow }}</span>{% endif %}
        <h2>{{ h.title }}</h2>
    </div>
    <div class="prose">
        {{ content|raw }}
    </div>
</section>
