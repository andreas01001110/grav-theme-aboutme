{% extends 'partials/base.html.twig' %}

{% block content %}
    <div class="page-head">
        {% if page.header.eyebrow %}<div class="eyebrow">{{ page.header.eyebrow }}</div>{% endif %}
        <h1>{{ page.title }}</h1>
        {% if page.header.lead %}<p class="lead">{{ page.header.lead }}</p>{% endif %}
    </div>
    <div class="form-card">
        {% include 'forms/form.html.twig' %}
        {% if page.content|trim %}<div class="form-note">{{ page.content|raw }}</div>{% endif %}
    </div>
{% endblock %}
